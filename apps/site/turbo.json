{
  "extends": ["//"],
  "tasks": {
    "generate": {
      "inputs": ["scripts/**", "$TURBO_ROOT$/packages/react/src/**", "$TURBO_ROOT$/pnpm-lock.yaml"],
      "outputs": [".generated/props/**"]
    },
    "build": {
      "outputs": ["out/**", ".next/**", "!.next/cache/**"],
      "inputs": ["$TURBO_DEFAULT$", "public/media/bento/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate", "build"]
    }
  }
}
